<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Mod Menu logic that needs no running game: version comparison, Vortex archive names.
       Run: dotnet test tests/ModMenu.Tests -->
  <PropertyGroup>
    <AssemblyName>ModMenu.Tests</AssemblyName>
    <RootNamespace>ModMenu.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DeployToGame>false</DeployToGame>
    <!-- The props turn this off for mods (nothing but the mod DLL ships); the test runner needs xunit next to it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built without copying it to the game: tests must not touch the installed mod. -->
    <ProjectReference Include="..\..\mods\ModMenu\ModMenu.csproj" AdditionalProperties="DeployToGame=false" />
  </ItemGroup>
</Project>

